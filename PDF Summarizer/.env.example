# Copy to .env and fill in real values. Never commit .env.

# Required
OPENAI_API_KEY=sk-...

# Server
PORT=5000
BASE_URL=http://localhost:5000

# OpenAI (optional — these are the defaults)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2

# CORS — comma-separated frontend origins allowed in production.
# Leave empty for local dev (any origin allowed).
ALLOWED_ORIGINS=

# Rate limiting (optional — defaults: 20 requests / hour per IP)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=3600000
